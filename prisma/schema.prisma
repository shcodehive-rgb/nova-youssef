datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Table dyal Course (Dourouss)
model Course {
  id          String  @id @default(uuid())
  userId      String  // Hada l-ID dyal Clerk
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)
  
  teacherName String? @db.Text
  teacherBio  String? @db.Text

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  chapters    Chapter[]
  attachments Attachment[]
  purchases   Purchase[]
  whitelistedUsers CourseWhitelist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// 2. Table dyal Chapter (Fossoul)
model Chapter {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  imageUrl    String? @db.Text
  videoUrl    String? @db.Text
  position    Int
  isPublished Boolean @default(false)
  isFree      Boolean @default(false)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  attachments Attachment[]
  userProgress UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@index([courseId])
}

// 3. Table dyal User (Mostakhdimin)
// Mohim: Hada bach grantAccess yl9a l-user b l-email
model User {
  id      String @id @default(uuid())
  email   String @unique
  name    String?
  
  // Relations
  purchases Purchase[] // Chno chra
}

// 4. Table dyal Purchase (Chira2)
model Purchase {
  id       String @id @default(uuid())
  userId   String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Relation m3a User local (Optionnel ila bghiti t-rbtoum)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@unique([userId, courseId]) // Bach maychrich nafs course joj marrat
  @@index([courseId])
}

// 5. Tables Sghar (Attachments, Category, Progress)
model Attachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDownloadable Boolean @default(false)

  @@index([courseId])
  @@index([chapterId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model UserProgress {
  id     String @id @default(uuid())
  userId String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@unique([userId, chapterId])
}

model CourseWhitelist {
  id        String   @id @default(uuid())
  email     String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([email, courseId]) // Prevent duplicate entries
}

model Comment {
  id String @id @default(uuid())
  text String @db.Text
  userId String
  userEmail String @default("Étudiant") // Store email/name here
  chapterId String
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([chapterId])
}

model SiteConfig {
  id String @id @default(uuid())
  userId String @unique
  
  heroTitle String? @db.Text
  heroDescription String? @db.Text
  heroImageUrl String? @db.Text

  name String? @db.Text
  logoUrl String? @db.Text
  
  // Dual Brand Logo
  logoText1 String?
  logoColor1 String? @default("#000000")
  logoText2 String? 
  logoColor2 String? @default("#ea580c") // Orange-600 default
  
  socialLinks Json? // { tiktok: string, instagram: string, whatsapp: string }
  footerCopyright String? @db.Text
  footerLogoUrl String? @db.Text
  footerBrandName String? @db.Text // Legacy/Fallback
  
  // Footer Dual Brand Logo
  footerLogoText1 String?
  footerLogoColor1 String? @default("#ffffff")
  footerLogoText2 String? 
  footerLogoColor2 String? @default("#ea580c")

  footerLinks Json? // [{ header: string, links: [{ label: string, url: string }] }]
  footerText String? @db.Text
  
  contactEmail String?
  
  // Carousel Results
  resultsImages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id String @id @default(uuid())
  userId String
  
  title String
  price Float
  currency String @default("DH")
  frequency String // "Mois", "Année", "Unique"
  features String @db.Text // JSON or newline separated
  isRecommended Boolean @default(false)
  url String? // Link to checkout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Page {
  id String @id @default(uuid())
  userId String
  title String
  slug String @unique
  content String @db.Text
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model BlogPost {
  id          String   @id @default(uuid())
  userId      String
  
  title       String   @db.Text
  content     String?  @db.Text
  coverImageUrl  String?  @db.Text
  
  slug        String   @unique
  metaTitle   String?  @db.Text
  metaDescription String? @db.Text
  keywords    String?  @db.Text
  
  isPublished Boolean  @default(false)
  
  viewCount   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([slug])
}